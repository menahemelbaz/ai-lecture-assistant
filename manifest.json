{
  "manifest_version": 3,
  "name": "AI Lecture Assistant",
  "version": "1.0",
  "description": "AI study assistant for recorded lectures",

  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],

  "host_permissions": [
    "http://localhost:3000/*",
    "ws://localhost:3001/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "dist/background.js"
  },

  "action": {
    "default_title": "Start or stop lecture capture",
     "default_icon": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style/overlay.css"],
      "js": [
        "dist/content/buttons.js",
        "dist/content/controller.js",
        "dist/content/manager.js",
        "dist/content/main.js"
      ],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "images/*.png",
        "style/overlay.css",
        "dist/content/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}