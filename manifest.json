{
  "manifest_version": 3,
  "name": "AI Lecture Assistant",
  "version": "1.0",
  "description": "AI study assistant for recorded lectures",
  "options_ui": {
    "page": "dist/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Start or stop lecture capture",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "vendor/katex/katex.min.css",
        "style/overlay.css"
      ],
      "js": [
        "vendor/katex/katex.min.js",
        "dist/content/buttons.js",
        "dist/content/controller.js",
        "dist/content/manager.js",
        "dist/content/main.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*.png",
        "style/overlay.css",
        "dist/content/*.js",
        "vendor/katex/katex.min.css",
        "vendor/katex/fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}